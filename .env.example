# Network & Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
UI_PORT=8501
API_BASE_URL=http://127.0.0.1:8000

# Markets & Universes
ENABLED_MARKETS=NSE,NYSE
NSE_UNIVERSE_PATH=data/nifty500.csv
# Confirmed additional NSE closures (comma-separated ISO dates); does not schedule Muhurat hours.
NSE_EXTRA_HOLIDAYS=2026-01-15
# Optional independent dated CSV; see docs/FEATURE_COMPLETION.md for the column contract.
NSE_REFERENCE_CSV=
CIRCUIT_BANDS_PCT=2,5,10,20
CIRCUIT_PROXIMITY_PCT=0.5
PE_REFERENCE_TOLERANCE_PCT=25
NYSE_UNIVERSE_PATH=data/otherlisted.txt
NYSE_EXCLUDE_NAME_PATTERN=\b(?:preferred|warrants?|units?|rights?|notes?|debentures?|bonds?|acquisition|funds?|municipals?|opportunit(?:y|ies)|strats|corts)\b|\b(?:term|income)\s+trusts?\b|\b(?:BlackRock|Eaton\s+Vance|Gabelli|abrdn|John\s+Hancock|Royce|Franklin\s+Universal)\b.*\b(?:trusts?|beneficial\s+interest)\b|\bEaton\s+Vance\b.*\bcommon\s+(?:stock|shares?)\b|\bcapital\s+trust\b|\btax[- ]free\s+income\s+portfolio\b

# Timing & Scheduling
# Scan interval in seconds (30–300); request totals depend on retries, caching and duration.
# Lower values increase UI freshness but multiply yfinance load proportionally.
REFRESH_INTERVAL_SEC=300
MARKET_CLOSE_SCAN_DELAY_MIN=20
POST_CLOSE_RETRY_INTERVAL_SEC=300
REFRESH_COOLDOWN_SEC=30
HISTORY_MODE=canonical
# 0 disables intraday SQLite history; JSON snapshots still update every scan.
HISTORY_INTRADAY_INTERVAL_SEC=0

# Download & Data Fetching
CHUNK_SIZE=100
CHUNK_DELAY_MIN_SEC=1
CHUNK_DELAY_MAX_SEC=2
DOWNLOAD_THREADS=4
PE_WORKERS=4
PE_CACHE_TTL_HOURS=24

# Resilience & Circuit Breakers
MAX_RETRIES=4
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_SEC=60
SCAN_MIN_FETCH_RATIO=0.5

# Technical & Fundamental Filters
RSI_PERIOD=14
MIN_RSI=40
RSI_CAP=80
REQUIRE_RSI_TREND_UP=true
MIN_VOLUME_RATIO=1.5
VOLUME_RATIO_CAP=10
VOLUME_LOOKBACK=20
MIN_AVG_VOLUME=0
# Previous completed sessions' mean Close * Volume; native-currency proxy, not VWAP turnover.
MIN_AVG_TRADED_VALUE_NSE=10000000
MIN_AVG_TRADED_VALUE_NYSE=1000000
MIN_VOLUME_PROJECTION_ELAPSED=0.25
OPTIMAL_PE=10
MAX_PE=50
MIN_PE=1
MIN_BARS=60
MAX_BAR_AGE_SESSIONS=2

# Scoring Weights & Logging
WEIGHT_VOLUME=0.40
WEIGHT_RSI=0.35
WEIGHT_PE=0.25
LOG_LEVEL=INFO

# Signal outcome tracking (NSE; local backend must be running)
PERFORMANCE_ENABLED=true
PERFORMANCE_DATA_DIR=data
PERFORMANCE_NIGHTLY_TIME=21:00
PERFORMANCE_BENCHMARK=^CRSLDX
PERFORMANCE_PRICE_BASIS=yahoo_split_adjusted_price
PERFORMANCE_BATCH_SIZE=5
PERFORMANCE_SYNC_CHUNK=5000
SQLITE_BUSY_TIMEOUT_SEC=30
PERFORMANCE_RETRY_SEC=300
PERFORMANCE_MAX_RETRIES=3
PERFORMANCE_TIMEOUT_SEC=10
PERFORMANCE_MIN_SAMPLE=20
PERFORMANCE_SCORE_EDGES=0,0.25,0.5,0.75,1
PERFORMANCE_VOLUME_EDGES=0,1.5,3,5,10
PERFORMANCE_RSI_EDGES=0,40,50,60,70,100

# Estimated NSE delivery-equity costs; 1 bp = 0.01%. Applied uniformly to reported history.
PERFORMANCE_BUY_STT_BPS=10
PERFORMANCE_SELL_STT_BPS=10
PERFORMANCE_STAMP_BPS=1.5
# Brokerage and other charges below are configurable estimates, not exact tax/fee calculations.
PERFORMANCE_BROKERAGE_BPS=0
PERFORMANCE_OTHER_COST_BPS=1
PERFORMANCE_SLIPPAGE_BPS=5

# New-signal webhook alerts (section 24). Empty = disabled. Sends JSON with "text"/"content"
# fields (Slack/Discord-style) plus structured "signals". The URL may hold a secret token: keep it in .env.
ALERT_WEBHOOK_URL=
ALERT_INCLUDE_PARTIAL=true
ALERT_TIMEOUT_SEC=5

# Swing S1: explicit local archive import only; existing scanner behavior is unchanged.
SWING_DB_PATH=data/swing.db
SWING_ARTIFACT_DIR=data/swing
SWING_SOURCE_DB_PATH=
SWING_MIN_HISTORY_SESSIONS=400
SWING_DELIVERY_SESSIONS=25
SWING_IMPORT_BATCH_SIZE=2000
SWING_SOURCE_TIMEOUT_SEC=10
SWING_BENCHMARK=^CRSLDX

# Swing S2: opt-in research hypotheses only; periods = exchange sessions.
# Swing S3: durable research replay only; no model promotion or broker orders.
SWING_PAPER_DB_PATH=data/swing_paper.db
SWING_REPLAY_ENABLED=false
SWING_REPLAY_MAX_SESSIONS=250
# Fractions refer to marked INR NAV; cost rates reuse PERFORMANCE_*_BPS.
# Explicit capital and a reconciled account book are required for sizing.
SWING_ENABLED=false
SWING_MODE=research
# SWING_CAPITAL_INR=  # Unset; do not enter a fictitious account balance
SWING_EMA_FAST=20
SWING_EMA_MID=50
SWING_EMA_SLOW=200
SWING_ATR_PERIOD=14
SWING_SLOPE_SESSIONS=10
SWING_RS_LOOKBACKS=21,63
SWING_VOLUME_LOOKBACK=20
SWING_MIN_AVG_TRADED_VALUE_INR=10000000
SWING_BREAKOUT_LOOKBACK=20
SWING_BREAKOUT_RVOL=1.5
SWING_BREAKOUT_EXTENSION_ATR=0.75
SWING_PULLBACK_LOOKBACK=5
SWING_PULLBACK_TOUCH_ATR=0.25
SWING_PULLBACK_DEPTH_ATR=3
SWING_PULLBACK_MAX_RVOL=1.2
SWING_PULLBACK_RECLAIM_RVOL=0.8
SWING_MAX_EXTENSION_ATR=3
SWING_MAX_CANDLE_ATR=2.5
SWING_MIN_CLOSE_LOCATION=0.6
SWING_STOP_BUFFER_ATR=0.2
SWING_MIN_STOP_ATR=0.75
SWING_MAX_STOP_ATR=3
SWING_TARGET_R=2
SWING_OVERHEAD_LOOKBACK=63
SWING_OVERHEAD_BUFFER_ATR=0.2
SWING_ENTRY_DIP_ATR=0.5
SWING_ENTRY_STOP_CLEARANCE_ATR=0.5
SWING_MAX_GAP_ATR=0.5
SWING_MIN_NET_RR=1.5
SWING_ENTRY_VALID_SESSIONS=1
SWING_BREAKOUT_MAX_HOLD=10
SWING_PULLBACK_MAX_HOLD=5
SWING_RISK_FRACTION=0.0025
SWING_MAX_POSITION_FRACTION=0.1
SWING_MAX_GROSS_FRACTION=0.6
SWING_MAX_OPEN_RISK_FRACTION=0.015
SWING_MAX_SECTOR_FRACTION=0.25
SWING_MAX_ADV_PARTICIPATION=0.005
SWING_MAX_CORRELATION=0.75
SWING_CORRELATION_SESSIONS=63
SWING_MIN_CORRELATION_OBSERVATIONS=30

# Swing S4: explicit offline validation CLI only. No account funding or automatic promotion.
VALIDATION_DB_PATH=data/swing_validation.db
# Dedicated shared authentication key, at least 32 bytes. Empty = disclosed UNSIGNED reports.
# Keep the actual key only in .env / the environment; never commit it.
VALIDATION_SIGNING_KEY=
VALIDATION_GATES__MIN_FOLDS=2
VALIDATION_GATES__MIN_TRADES=100
VALIDATION_GATES__MIN_PERIODS=20
VALIDATION_GATES__MIN_SECTORS=3
VALIDATION_GATES__MIN_NEIGHBORS=2
VALIDATION_GATES__EMBARGO_SESSIONS=5
VALIDATION_GATES__BLOCK_SESSIONS=20
VALIDATION_GATES__BOOTSTRAP_REPLICATES=2000
VALIDATION_GATES__SEED=1729
VALIDATION_GATES__ALPHA=0.05
VALIDATION_GATES__MAX_DRAWDOWN=0.10
VALIDATION_GATES__MAX_EXPOSURE=0.60
VALIDATION_GATES__MAX_PARTICIPATION=0.005
VALIDATION_GATES__MIN_FILL_COVERAGE=0.80
VALIDATION_GATES__NEIGHBOR_RATIO=0.50
VALIDATION_GATES__BASELINE_EXPOSURE=0.60
VALIDATION_GATES__EXTRA_COST_BPS=[10,25]
VALIDATION_GATES__ENTRY_DELAY_SESSIONS=1
VALIDATION_GATES__ADVERSE_GAP_BPS=100
VALIDATION_GATES__EXIT_HALT_SESSIONS=1
VALIDATION_GATES__EXECUTION_STRESS_FRACTION=0.10
VALIDATION_GATES__MAX_PARAMETER_CHANGE_FRACTION=0.20

# Swing S5: local operations, source inspection and durable lifecycle notifications.
# These are presentation/operations settings, separate from frozen strategy parameters.
SWING_OPS_DB_PATH=data/swing_ops.db
# Dedicated opt-in destination; never inherits ALERT_WEBHOOK_URL. Empty = no delivery.
SWING_LIFECYCLE_WEBHOOK_URL=
SWING_LIFECYCLE_TIMEOUT_SEC=5
SWING_LIFECYCLE_BATCH_SIZE=20
SWING_CHART_BARS=120

# S6 explicit prospective observation journal; no scheduler or auto-promotion.
SWING_FORWARD_DB_PATH=data/swing_forward.db
SWING_FORWARD_MIN_SESSIONS=30

# Macro Indicators (India VIX, Brent Crude, Nifty 50 / GIFT Proxy)
MACRO_ENABLED=true
MACRO_TICKER_NIFTY=^NSEI
MACRO_TICKER_VIX=^INDIAVIX
MACRO_TICKER_BRENT=BZ=F
MACRO_CACHE_TTL_SEC=60
MACRO_VIX_LOW_THRESHOLD=14.0
MACRO_VIX_HIGH_THRESHOLD=20.0
