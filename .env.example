# Network & Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
UI_PORT=8501
API_BASE_URL=http://127.0.0.1:8000

# Markets & Universes
ENABLED_MARKETS=NSE,NYSE
NSE_UNIVERSE_PATH=data/nifty500.csv
# Confirmed additional NSE closures (comma-separated ISO dates); does not schedule Muhurat hours.
NSE_EXTRA_HOLIDAYS=2026-01-15
# Optional independent dated CSV; see docs/FEATURE_COMPLETION.md for the column contract.
NSE_REFERENCE_CSV=
CIRCUIT_BANDS_PCT=2,5,10,20
CIRCUIT_PROXIMITY_PCT=0.5
PE_REFERENCE_TOLERANCE_PCT=25
NYSE_UNIVERSE_PATH=data/otherlisted.txt
NYSE_EXCLUDE_NAME_PATTERN=\b(?:preferred|warrants?|units?|rights?|notes?|debentures?|bonds?|acquisition|funds?|municipals?|opportunit(?:y|ies)|strats|corts)\b|\b(?:term|income)\s+trusts?\b|\b(?:BlackRock|Eaton\s+Vance|Gabelli|abrdn|John\s+Hancock|Royce|Franklin\s+Universal)\b.*\b(?:trusts?|beneficial\s+interest)\b|\bEaton\s+Vance\b.*\bcommon\s+(?:stock|shares?)\b|\bcapital\s+trust\b|\btax[- ]free\s+income\s+portfolio\b

# Timing & Scheduling
# Scan interval in seconds (30–300); request totals depend on retries, caching and duration.
# Lower values increase UI freshness but multiply yfinance load proportionally.
REFRESH_INTERVAL_SEC=300
MARKET_CLOSE_SCAN_DELAY_MIN=20
POST_CLOSE_RETRY_INTERVAL_SEC=300
REFRESH_COOLDOWN_SEC=30
HISTORY_MODE=canonical
# 0 disables intraday SQLite history; JSON snapshots still update every scan.
HISTORY_INTRADAY_INTERVAL_SEC=0

# Download & Data Fetching
CHUNK_SIZE=100
CHUNK_DELAY_MIN_SEC=1
CHUNK_DELAY_MAX_SEC=2
DOWNLOAD_THREADS=4
PE_WORKERS=4
PE_CACHE_TTL_HOURS=24

# Resilience & Circuit Breakers
MAX_RETRIES=4
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_SEC=60
SCAN_MIN_FETCH_RATIO=0.5

# Technical & Fundamental Filters
RSI_PERIOD=14
MIN_RSI=40
RSI_CAP=80
REQUIRE_RSI_TREND_UP=true
MIN_VOLUME_RATIO=1.5
VOLUME_RATIO_CAP=10
VOLUME_LOOKBACK=20
MIN_AVG_VOLUME=0
# Previous completed sessions' mean Close * Volume; native-currency proxy, not VWAP turnover.
MIN_AVG_TRADED_VALUE_NSE=10000000
MIN_AVG_TRADED_VALUE_NYSE=1000000
MIN_VOLUME_PROJECTION_ELAPSED=0.25
OPTIMAL_PE=10
MAX_PE=50
MIN_PE=1
MIN_BARS=60
MAX_BAR_AGE_SESSIONS=2

# Scoring Weights & Logging
WEIGHT_VOLUME=0.40
WEIGHT_RSI=0.35
WEIGHT_PE=0.25
LOG_LEVEL=INFO

# Signal outcome tracking (NSE; local backend must be running)
PERFORMANCE_ENABLED=true
PERFORMANCE_DATA_DIR=data
PERFORMANCE_NIGHTLY_TIME=21:00
PERFORMANCE_BENCHMARK=^CRSLDX
PERFORMANCE_PRICE_BASIS=yahoo_split_adjusted_price
PERFORMANCE_BATCH_SIZE=5
PERFORMANCE_SYNC_CHUNK=5000
SQLITE_BUSY_TIMEOUT_SEC=30
PERFORMANCE_RETRY_SEC=300
PERFORMANCE_MAX_RETRIES=3
PERFORMANCE_TIMEOUT_SEC=10
PERFORMANCE_MIN_SAMPLE=20
PERFORMANCE_SCORE_EDGES=0,0.25,0.5,0.75,1
PERFORMANCE_VOLUME_EDGES=0,1.5,3,5,10
PERFORMANCE_RSI_EDGES=0,40,50,60,70,100

# Estimated NSE delivery-equity costs; 1 bp = 0.01%. Applied uniformly to reported history.
PERFORMANCE_BUY_STT_BPS=10
PERFORMANCE_SELL_STT_BPS=10
PERFORMANCE_STAMP_BPS=1.5
# Brokerage and other charges below are configurable estimates, not exact tax/fee calculations.
PERFORMANCE_BROKERAGE_BPS=0
PERFORMANCE_OTHER_COST_BPS=1
PERFORMANCE_SLIPPAGE_BPS=5

# New-signal webhook alerts (section 24). Empty = disabled. Sends JSON with "text"/"content"
# fields (Slack/Discord-style) plus structured "signals". The URL may hold a secret token: keep it in .env.
ALERT_WEBHOOK_URL=
ALERT_INCLUDE_PARTIAL=true
ALERT_TIMEOUT_SEC=5
